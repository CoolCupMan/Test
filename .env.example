# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ANTHROPIC_API_KEY: Optional server-side default Anthropic (Claude) key, used
# when a request doesn't supply its own key. Not required — users can instead
# connect their own key from the app's Login screen.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_MODEL: Overrides the Claude model used for AI text analysis.
# Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL="claude-opus-5"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console, required
# for the real "Sign in with Google" button to work (web + the packaged Android
# app). See README.md > "Configuring real Google Sign-In" for setup steps.
VITE_GOOGLE_CLIENT_ID=""

# VITE_API_BASE_URL: Base URL of this app's own Express server (/api/...), used
# by the packaged Android build (its WebView has no on-device Node server, so
# relative /api/... calls need an absolute URL). Leave empty for web/dev preview.
# Set this to the same value as APP_URL before building the Android APK.
VITE_API_BASE_URL=""
